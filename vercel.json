{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/photo/:fileId",
      "destination": "/api/photo?fileId=:fileId"
    },
    {
      "source": "/api/photo",
      "destination": "/api/photo"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
